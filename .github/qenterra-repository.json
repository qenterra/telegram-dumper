{
  "$schema": "./qenterra-repository.schema.json",
  "agent_control_plane": false,
  "allowed_root_paths": [
    "src",
    "tests",
    "scripts",
    "docs",
    "pyproject.toml"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "0.1.0",
  "default_branch": "main",
  "dependabot_ecosystem": "pip",
  "description": "A terminal client for downloading permitted media and files from Telegram chats.",
  "documentation_root": "docs",
  "ecosystem": "python",
  "exceptions": [
    {
      "approval_source": "repository contract",
      "owner": "@qenterra",
      "path_or_setting": "src/telegram_dumper",
      "reason": "Python package import identifiers cannot contain hyphens.",
      "review_trigger": "Recheck if the package layout or Python import contract changes.",
      "rule": "path-naming"
    },
    {
      "approval_source": "repository contract",
      "owner": "@qenterra",
      "path_or_setting": "src/telegram_dumper/__init__.py",
      "reason": "Python requires the exact __init__.py package entrypoint spelling.",
      "review_trigger": "Recheck if the Python package entrypoint contract changes.",
      "rule": "path-naming"
    },
    {
      "approval_source": "repository contract",
      "owner": "@qenterra",
      "path_or_setting": "src/telegram_dumper/telegram_client.py",
      "reason": "The module is imported by Python using its underscore-containing identifier.",
      "review_trigger": "Recheck if this module is renamed or the import contract changes.",
      "rule": "path-naming"
    },
    {
      "approval_source": "repository contract",
      "owner": "@qenterra",
      "path_or_setting": "tests",
      "reason": "The repository standard includes tests/ as an exact ecosystem-native path.",
      "review_trigger": "Recheck if the project changes its Python test discovery layout.",
      "rule": "path-naming"
    }
  ],
  "github_features": {
    "discussions": false,
    "issues": false,
    "projects": false,
    "wiki": false
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra-repository-check.py",
      "docs/readme.md",
      "docs/architecture.md",
      "docs/development.md",
      "docs/testing.md",
      "docs/releasing.md",
      "docs/dependencies.md",
      "docs/style-guide.md",
      "docs/troubleshooting.md",
      "docs/github-settings.md",
      "docs/maintenance.md",
      "docs/decisions/readme.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "README.md",
      "docs/data-classification.md",
      "docs/retention.md",
      "LICENSE"
    ],
    "standard_version": "2.0.0"
  },
  "homepage_url": "https://github.com/QenTerra/telegram-dumper",
  "install_command": "gh auth setup-git && pipx install 'git+https://github.com/QenTerra/telegram-dumper.git'",
  "license": "Proprietary",
  "merge_strategy": "squash",
  "minimum_requirements": "Python 3.12 or newer, a Telegram API application ID and hash, and a Telegram account permitted to access the source chat.",
  "overlays": [],
  "primary_language": "English",
  "profile": "private",
  "project_name": "telegram-dumper",
  "published_artifacts": [],
  "quick_start_command": "telegram-dumper --help",
  "release_mode": "none",
  "repository_name": "telegram-dumper",
  "repository_url": "https://github.com/QenTerra/telegram-dumper",
  "security_url": "https://github.com/QenTerra/telegram-dumper/security/advisories/new",
  "standard_version": "2.0.0",
  "support_url": "https://github.com/QenTerra/telegram-dumper",
  "topics": [
    "telegram",
    "telegram-api",
    "python",
    "cli",
    "media-downloader"
  ],
  "verification_command": "bash scripts/verify-repository.sh",
  "version_scheme": "semver",
  "version_source": "pyproject.toml",
  "version_tag_prefix": "v",
  "visibility": "private",
  "wiki_source": "disabled"
}
